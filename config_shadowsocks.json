{
  "log": {
    "loglevel": "warning"
  },
  "inbounds": [
    {
      "tag": "ss-in",
      "port": 8080,
      "listen": "0.0.0.0",
      "protocol": "shadowsocks",
      "settings": {
        "method": "aes-256-gcm",
        "password": "PLACEHOLDER_PASSWORD",
        "network": "tcp"
      },
      "sniffing": {
        "enabled": true,
        "destOverride": ["http", "tls"]
      }
    }
  ],
  "outbounds": [
    {
      "tag": "direct",
      "protocol": "freedom"
    }
  ]
}